# ONLY needed for the automatic API workflow (newsagent ingest / ask / chat).
# The manual chat workflow (newsagent prompt + load + digest + search)
# needs no key at all.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used for summarising + topic tagging. Default: claude-opus-5
NEWSAGENT_MODEL=claude-opus-5

# Model used for splitting page text into articles. This is a mechanical
# extraction job, so a cheaper model works well here and is the single
# biggest cost lever in this pipeline. Try claude-haiku-4-5 to cut cost.
NEWSAGENT_SEGMENT_MODEL=claude-opus-5

# Effort level for the LLM calls: low | medium | high | xhigh | max
NEWSAGENT_EFFORT=medium

# Where things live (relative paths resolve against the project root)
NEWSAGENT_DB=data/articles.db
NEWSAGENT_TOPICS_FILE=topics.txt
NEWSAGENT_INBOX=inbox

# Where generated chat prompts are written (manual, no-API workflow)
NEWSAGENT_PROMPTS=prompts

# Where the HTML reading page is written
NEWSAGENT_REPORTS=reports

# Max pages to process in one run (0 = no limit). Useful for a cheap dry run.
NEWSAGENT_MAX_PAGES=0

# ============================================================================
# Webapp (PostgreSQL-backed API + browser UI) -- see webapp/README.md
# ============================================================================

# Base URL of the running webapp, used by 'newsagent push-web'.
# Leave blank to disable push-web (the manual/local workflow above is
# entirely unaffected either way).
NEWSAGENT_API_URL=http://localhost:8000

# --- PostgreSQL connection used by the webapp itself (webapp/config.py) ---
# DUMMY VALUES -- replace with your real database credentials before running
# the webapp against anything but a throwaway local database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=newspaper_agent
POSTGRES_USER=newspaper_user
POSTGRES_PASSWORD=changeme_dummy_password

# --- FastAPI server bind address (uvicorn webapp.main:app) ---
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
# Comma-separated list of allowed CORS origins, or * for any (local dev only)
WEBAPP_CORS_ORIGINS=*
